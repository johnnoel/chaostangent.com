{% extends 'base.html.twig' %}
{% block title %}
    {{ category.title }}
    {% if page > 1 %}
        : Page {{ page }}
    {% endif %}
{% endblock %}

{% block body %}
    {% include '_posts-list.html.twig' with {
        'posts': posts,
        'route': 'category:paginated',
        'page_1_route': 'category',
        'route_params': { 'alias': category.alias },
        'page': page,
        'pages': page_count,
        'title': 'Posts categorised “' ~ category.title ~ '”',
    } %}
{% endblock body %}
