{% extends 'base.html.twig' %}

{% block body %}
    <article id="post-{{ post.id }}" role="article">
        {% set post_link = path('post', post.routeParams) %}
        <header class="post-title">
            <h1><a href="{{ post_link }}" title="Permanent Link to {{ post.title|e('html_attr') }}" rel="bookmark">{{ post.title }}</a></h1>
            {% if post.subtitle is not empty %}<h2>{{ post.subtitle }}</h2>{% endif %}
        </header>

        <aside class="post-datetime">
            <time datetime="{{ post.date|date('Y-m-d\\TH:i:sP') }}">
                <span class="post-datetime-day">{{ post.date|date('d') }}</span><span class="post-datetime-month">{{ post.date|date('M') }}</span><span class="post-datetime-year">{{ post.date|date('Y') }}</span><span class="post-datetime-time">{{ post.date|date('H:i') }}</span>
            </time>
        </aside>

        <div class="post-content">
            {{ post.content|pullquote(post.extra)|full|raw }}
        </div>

        <aside class="post-appreciate">
            <h5>Support chaostangent.com</h5>

            <div class="post-appreciate-inner" id="#appreciate">
                <div class="post-appreciate-kudos">
                    <p>Appreciate the post? Let me&nbsp;know!</p>
                    {#<form action="{{ path('kudo', post.routeParams) }}" method="post">
                        <button type="submit" id="kudos" data-post-id="{{ post.id }}"><svg><use xlink:href="/img/icons.svg#checkmark"></use></svg> Appreciate this post</button>
                    </form>#}
                </div>

                {% set post_url = url('post', post.routeParams) %}
                <div class="post-appreciate-share">
                    <p>Share this post with others:</p>
                    <a href="https://twitter.com/intent/tweet?url={{ post_url|e('url') }}&amp;text={{ post.fullTitle|e('url') }}" title="Share this post on Twitter"><svg><use xlink:href="/img/icons.svg#twitter"></use></svg> Share on Twitter</a>
                    <a href="https://www.facebook.com/sharer/sharer.php?u={{ post_url|e('url') }}" title="Share this post on Facebook"><svg><use xlink:href="/img/icons.svg#facebook"></use></svg> Share on Facebook</a>
                    <a href="https://www.tumblr.com/widgets/share/tool?canonicalUrl={{ post_url|e('url') }}&amp;content={{ post_url|e('url') }}&amp;title={{ post.fullTitle|e('url') }}" title="Share this post on Tumblr"><svg><use xlink:href="/img/icons.svg#tumblr"></use></svg> Share on Tumblr</a>
                    <a href="https://www.reddit.com/submit?url={{ post_url|e('url') }}&amp;title={{ post.fullTitle|e('url') }}" title="Share this post on Reddit"><svg><use xlink:href="/img/icons.svg#reddit"></use></svg> Share on Reddit</a>
                </div>
            </div>
        </aside>

        {#{{ render(controller('App\\Controller\\PostsController::similar', { 'post': post })) }}#}

        <footer class="post-meta">
            <div class="post-meta-categories">
                <h5 class="post-meta-title">Categorised and filed neatly under:</h5>
                <ul>{% for category in post.categories %}<li><a href="{{ path('category', { 'alias': category.alias }) }}" title="View all posts in {{ category.title|e('html_attr') }}">{{ category.title }}</a></li>{% endfor %}</ul>
            </div>

            {% if tags|default([])|length > 0 %}
                <div class="post-meta-tags">
                    <h5 class="post-meta-title">Meticulously tagged with:</h5>
                    <ul>
                        {% for tag in tags|default([]) %}
                            <li>
                                {% if tag.postCount > 1 %}
                                    <a href="{{ path('tag', { 'alias': tag.alias }) }}">{{ tag.tag }}</a>
                                {% else %}
                                    {{ tag.tag }}
                                {% endif %}
                            </li>
                        {% endfor %}
                    </ul>
                </div>
            {% endif %}
        </footer>

        <section class="responses" id="responses">
            {% if post.comments|length > 0 %}
                <h1 class="responses-title">Responses to &ldquo;{{ post.title }}&rdquo;</h1>
                {% include 'comments.html.twig' with { 'comments': post.commentsTree, 'post': post, 'depth': 1 } %}
            {% endif %}

            {% if isFeatureEnabled('comments') %}
                {{ form_start(comment_form, { 'attr': { 'id': 'respond', 'class': 'respond t__respond' }}) }}
                <fieldset>
                    <legend class="respond-title">Respond to &ldquo;{{ post.title }}&rdquo;</legend>
                    <h2 class="respond-subtitle">Community rules:</h2>
                    <ol class="respond-rules">
                        <li><b>Keep it civil</b>: no personal attacks, slurs, harassment, hate speech, or threats</li>
                        <li><b>No spam</b>: includes marketing, pyramid schemes, scams etc.</li>
                        <li><b>Notify of any spoilers</b>: even if it's for something the post isn't about</li>
                        <li><b>Your response may be edited or removed</b>: if your response was in good faith, you may be contacted via email explaining why</li>
                    </ol>
                    {% if not comment_form.vars.valid %}
                        <div class="respond-haserrors">There was an issue with adding your response. Please correct the errors detailed next to each field to continue.</div>
                    {% endif %}
                    {{ form_row(comment_form.authorName, { 'label': 'Your name' }) }}
                    {{ form_row(comment_form.authorEmail, { 'label': 'Your email address', 'help': 'Your address will never be shared' }) }}
                    {{ form_row(comment_form.authorUrl, { 'label': 'Your site URL' }) }}
                    {{ form_row(comment_form.comment, { 'label': 'Response', 'help': 'The following HTML tags are allowed: <b> <strong> <i> <em> <a href>' }) }}
                    {{ form_row(comment_form.honeypot, { 'label': 'Spam bot honeypot, please do not check this box' }) }}
                    {{ form_rest(comment_form) }}
                    <button type="submit" class="respond-submit">Add response</button>
                </fieldset>
                {{ form_end(comment_form) }}
            {% endif %}
        </section>
    </article>
{% endblock body %}
