{% extends 'base.html.twig' %}
{% set post_link = path('post', post.routeParams) %}
{% block title %}{{ post.fullTitle }}{% endblock title %}

{% block head %}
    <link rel="webmention" href="{{ absolute_url(path('webmention')) }}">
    <link rel="pingback" href="{{ absolute_url(path('pingback')) }}">
{% endblock %}

{% block opengraph %}
    <meta property="og:locale" content="en_GB">
    <meta property="og:type" content="article">
    <meta property="og:url" content="{{ absolute_url(post_link) }}">
    <meta property="og:title" content="{{ post.fullTitle }} : chaostangent">
    <meta property="og:site_name" content="chaostangent">
    <meta property="og:description" content="More squirrels than sense">
    {% if post.image.src|default is not empty %}
        <meta property="og:image" content="{{ absolute_url('/media/' ~ post.image.src) }}">
        <meta property="og:image:width" content="{{ post.image.src|image_width }}">
        <meta property="og:image:height" content="{{ post.image.src|image_height }}">
        <meta property="og:image:type" content="{{ post.image.src|image_type }}">
    {% else %}
        <meta property="og:image" content="{{ absolute_url(asset('img/opengraph.png')) }}">
        <meta property="og:image:width" content="1920">
        <meta property="og:image:height" content="1080">
        <meta property="og:image:type" content="image/png">
    {% endif %}
    <meta property="article:published_time" content="{{ post.date|date('Y-m-d\\TH:i:sP') }}">
    <meta property="article:modified_time" content="{{ post.updated|date('Y-m-d\\TH:i:sP') }}">
    {% if post.categories|length > 0 %}
        <meta property="article:section" content="{{ post.categories[0].title }}">
    {% endif %}
    {% for t in tags|filter(t => t.postCount > 1)|slice(0, 5) %}
        <meta property="article:tag" content="{{ t.tag.tag }}">
    {% endfor %}
    <meta property="twitter:card" content="summary">
{% endblock opengraph %}

{% block body %}
    <article id="post-{{ post.id }}" class="blog-post h-entry" role="article">
        <header>
            <h1 class="p-name"><a href="{{ post_link }}" title="Permanent Link to {{ post.title|e('html_attr') }}" rel="bookmark" class="u-url u-uid">{{ post.title }}</a></h1>
            {% if post.subtitle is not empty %}<h2>{{ post.subtitle }}</h2>{% endif %}
        </header>

        <aside>
            <time class="dt-published" datetime="{{ post.date|date('Y-m-d\\TH:i:sP') }}">
                <span class="day">{{ post.date|date('d') }}</span><span class="month">{{ post.date|date('M') }}</span><span class="year">{{ post.date|date('Y') }}</span><span class="time">{{ post.date|date('H:i') }}</span>
            </time>
        </aside>

        <div class="full content e-content">
            {{ include(template_from_string(post.content)) }}
        </div>

        <footer class="post-meta">
            <div class="categories">
                <h5>Categorised and filed neatly under:</h5>
                <ul>
                    {# Must be on one line to prevent odd spacing between the end of the word and the comma suffix #}
                    {%- for category in post.categories -%}
                        <li><a href="{{ path('category', { 'alias': category.alias }) }}" title="View all posts in {{ category.title|e('html_attr') }}" class="p-category">{{ category.title }}</a></li>
                    {%- endfor -%}
                </ul>
            </div>

            {% if tags|length > 0 %}
                <div class="tags">
                    <h5>Meticulously tagged with:</h5>
                    <ul>
                        {% for t in tags %}
                            <li>
                                {% if t.postCount > 1 %}
                                    <a href="{{ path('tag', { 'alias': t.tag.alias }) }}" class="p-category">{{ t.tag.tag }}</a>
                                {% else %}
                                    <span class="p-category">{{ t.tag.tag }}</span>
                                {% endif %}
                            </li>
                        {% endfor %}
                    </ul>
                </div>
            {% endif %}
        </footer>

        <nav class="post-prevnext">
            {% if prev_post is defined and prev_post is not null %}
                <a href="{{ path('post', prev_post.routeParams) }}" class="prev">
                    <span><svg><use xlink:href="{{ asset('icons.svg') }}#icon-back"></use></svg></span>
                    <small>Older:</small>
                    <h4>{{ prev_post.title }}</h4>
                    {% if prev_post.subtitle is not empty %}<h5>{{ prev_post.subtitle }}</h5>{% endif %}
                </a>
            {% endif %}
            {% if next_post is defined and next_post is not null %}
                <a href="{{ path('post', next_post.routeParams) }}" class="next">
                    <span><svg><use xlink:href="{{ asset('icons.svg') }}#icon-forward"></use></svg></span>
                    <small>Newer:</small>
                    <h4>{{ next_post.title }}</h4>
                    {% if next_post.subtitle is not empty %}<h5>{{ next_post.subtitle }}</h5>{% endif %}
                </a>
            {% endif %}
        </nav>

        <section id="responses">
            {% if comments|length > 0 %}
                <div class="responses-list">
                    <h1>Responses to &ldquo;{{ post.title }}&rdquo;</h1>
                    {% include '_comments.html.twig' with { 'comments': comments, 'post': post, 'depth': 1 } %}
                </div>
            {% endif %}

            {% if isFeatureEnabled('comments') %}
                {# If you change the ID here, be sure to update the _fragment route parameter in CommentsController #}
                {{ form_start(comment_form, {
                    'action': path('comment', post.routeParams),
                    'attr': { 'id': 'respond', 'class': 'response-form' }
                }) }}
                <fieldset>
                    <legend>Respond to &ldquo;{{ post.title }}&rdquo;</legend>
                    <h2>Community rules:</h2>
                    <ol class="rules">
                        <li><b>Keep it civil</b>: no personal attacks, slurs, harassment, hate speech, or threats</li>
                        <li><b>No spam</b>: includes marketing, pyramid schemes, scams etc.</li>
                        <li><b>Notify of any spoilers</b>: even if it's for something the post isn't about</li>
                        <li><b>Your response may be edited or removed</b>: if your response was in good faith, you may be contacted via email explaining why</li>
                    </ol>
                    {% if not comment_form.vars.valid %}
                        <div class="errors">There was an issue with adding your response. Please correct the errors detailed next to each field to continue.</div>
                    {% endif %}
                    {{ form_row(comment_form.authorName, { 'label': 'Your name' }) }}
                    {{ form_row(comment_form.authorEmail, { 'label': 'Your email address', 'help': 'Your address will never be shared' }) }}
                    {{ form_row(comment_form.authorUrl, { 'label': 'Your site URL' }) }}
                    {{ form_row(comment_form.comment, { 'label': 'Response', 'help': 'The following HTML tags are allowed: <b> <strong> <i> <em> <a href>' }) }}
                    {{ form_row(comment_form.honeypot, { 'label': 'Spam bot honeypot, please do not check this box' }) }}
                    {{ form_rest(comment_form) }}
                    <button type="submit">Add response</button>
                </fieldset>
                {{ form_end(comment_form) }}
            {% endif %}
        </section>
    </article>
{% endblock body %}

{% block jsonld %}
    <script type="application/ld+json">
        {{ post|serialize(format = 'json-ld')|raw }}
    </script>
{% endblock jsonld %}
