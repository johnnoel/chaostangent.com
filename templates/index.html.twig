{% extends 'base.html.twig' %}
{% block title %}
    {% if page > 1 %}
        Page {{ page }}
    {% endif %}
{% endblock title %}

{% block pre_body %}
    {% if image_strip|default([])|length > 0 %}
        <nav class="image-strip">
            <ul>
                {% for p in image_strip %}
                    <li class="post{% if p.post.extra.image|default('') is empty %} -no-image{% endif %}">
                        <a href="{{ path('post', p.post.routeParams) }}" title="{{ p.post.fullTitle }}">
                            <div class="titles">
                                <h5>{{ p.post.title }}</h5>
                                {% if p.post.subtitle is not empty %}
                                    <h6>{{ p.post.subtitle }}</h6>
                                {% endif %}
                            </div>
                        </a>
                        {% if p.post.image is not empty %}
                            {{ picture(p.post.image) }}
                        {% else %}
                            <picture><img src="img/placeholder.png" alt=""></picture>
                        {% endif %}
                    </li>
                {% endfor %}
            </ul>
        </nav>
    {% endif %}
{% endblock pre_body %}

{% block body %}
    {% include '_posts-list.html.twig' with {
        'posts': posts,
        'route': 'home:paginated',
        'page_1_route': 'home',
        'route_params': [],
        'page': page,
        'pages': page_count,
    } %}
{% endblock body %}

{% block jsonld %}
    <script type="application/ld+json">
        {
          "@context": "https://schema.org",
          "@id": "{{ absolute_url(path('home')) }}",
          "@type": "Blog",
          "name": "chaostangent.com",
          "description": "More squirrels than sense",
          "url": "{{ absolute_url(path('home')) }}",
          "author": {
            "@type": "Person",
            "name": "chaostangent",
            "url": "https://chaostangent.com"
          }
        }
    </script>
{% endblock jsonld %}
