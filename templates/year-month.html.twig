{% extends 'base.html.twig' %}
{% block title %}
    {{ (year ~ '-' ~ month ~ '-01')|date('F Y') }}
    {% if page > 1 %}
        : Page {{ page }}
    {% endif %}
{% endblock title %}

{% block body %}
    {% include '_posts-list.html.twig' with {
        'posts': posts,
        'route': 'month:paginated',
        'page_1_route': 'month',
        'route_params': { 'year': year, 'month': '%02d'|format(month) },
        'page': page,
        'pages': page_count,
        'title': 'Posts from ' ~ ((year ~ '-' ~ month ~ '-01')|date('F Y')),
    } %}
{% endblock body %}
