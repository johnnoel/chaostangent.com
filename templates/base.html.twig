<!DOCTYPE html>
<html lang="en-gb">
<head>
    <meta charset="utf-8">
    <!--
          _                     _                               _
         | |                   | |                             | |
      ___| |__   __ _  ___  ___| |_ __ _ _ __   __ _  ___ _ __ | |_
     / __| '_ \ / _` |/ _ \/ __| __/ _` | '_ \ / _` |/ _ \ '_ \| __|
    | (__| | | | (_| | (_) \__ \ || (_| | | | | (_| |  __/ | | | |_
     \___|_| |_|\__,_|\___/|___/\__\__,_|_| |_|\__, |\___|_| |_|\__|
                                                __/ |
                                               |___/

    Like what you see? All of the code is available on GitHub for you to peruse
    and use: https://github.com/johnnoel/chaostangent.com.
    -->
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="More squirrels than sense">

    <title>{% block title %}{% endblock %}{% if block('title') is not empty %} : {% endif %}chaostangent</title>

    <link rel="shortcut icon" href="{{ asset('img/favicon.ico') }}" sizes="16x16">
    <link rel="icon" href="{{ asset('img/favicon-32x32.png') }}" sizes="32x32" type="image/png">
    <link rel="apple-touch-icon-precomposed" href="{{ asset('img/favicon-128x128.png') }}">

    {% block share %}
        <meta property="og:type" content="">
        <meta property="og:url" content="{{ app.request.uri }}">
        <meta property="og:title" content="{{ block('title') }}{% if block('title') is not empty %} : {% endif %}chaostangent">
        <meta property="og:description" content="More squirrels than sense">
        <meta property="og:image" content="{{ absolute_url(asset('img/favicon-128x128.png')) }}">
    {% endblock %}

    {% block feeds %}
        <link rel="alternate" type="application/rss+xml" title="chaostangent RSS 2.0 feed" href="{{ url('home:rss') }}">
        <link rel="alternate" type="application/atom+xml" title="chaostangent Atom feed" href="{{ url('home:atom') }}">
    {% endblock %}

    <link rel="search" type="application/opensearchdescription+xml" href="{{ url('opensearch') }}" title="chaostangent.com search">
    <link rel="stylesheet" href="{{ asset('main.css') }}">
</head>
<body>
<nav class="a11y-nav" role="navigation">
    <a href="#main">Jump to content</a>
    <a href="#primarynav">Jump to menu</a>
    <a href="#primaryfilter">Jump to filter</a>
</nav>

<header class="site-header" role="banner">
    <a href="{{ path('home') }}" title="More squirrels than sense" class="logo">chaos<b>tangent</b></a>

    <nav id="primarynav" class="nav" role="navigation">
        <ul>
            <li{% if location|default('home') == 'home' %} class="active"{% endif %}><a href="{{ path('home') }}">Home</a></li>
            <li{% if location|default('home') == 'about' %} class="active"{% endif %}><a href="{{ path('about') }}">About</a></li>
            <li><a href="http://chaostangent.tumblr.com" target="_blank">Tumblr</a></li>
            <li class="primarynav-feed"><a href="{{ path('home:rss') }}"><svg><use xlink:href="/img/icons.svg#rss"></use></svg> RSS feed</a></li>
        </ul>
    </nav>

    <form method="get" action="{{ path('search') }}" class="search-form">
        <input type="search" name="q" placeholder="Search..." class="query" value="{{ search_query|default('') }}">
        <button type="submit" class="search"><svg><use xlink:href="/img/icons.svg#search"></use></svg> Search</button>
    </form>
</header>

<main id="main" role="main">
    {% block body %}{% endblock %}
</main>

<nav id="primaryfilter" class="primaryfilter" role="navigation">
    <h5 class="primaryfilter-title">Filter posts by:</h5>
    <div class="primaryfilter-filter primaryfilter-calendar">
        <h6 class="primaryfilter-subtitle">Date</h6>
        {{ render_esi(controller('App\\Controller\\DefaultController::calendar')) }}
    </div>

    <div class="primaryfilter-filter primaryfilter-categories">
        <h6 class="primaryfilter-subtitle">Categories</h6>
        {{ render_esi(controller('App\\Controller\\DefaultController::categoryTree')) }}
    </div>

    <div class="primaryfilter-filter primaryfilter-tags">
        <h6 class="primaryfilter-subtitle">Most used tags</h6>
        {{ render_esi(controller('App\\Controller\\DefaultController::tagCloud')) }}
    </div>
</nav>

<footer class="sitefooter">
    <nav class="socialmedia" role="navigation">
        <ul>
            <li><a href="https://bsky.app/profile/johnnoel.uk"><svg><use xlink:href="/img/icons.svg#twitter"></use></svg> My posts on Bluesky</a></li>
            <li><a href="https://mastodon.social/@ceetea"><svg><use xlink:href="/img/icons.svg#twitter"></use></svg> My toots on Mastodon</a></li>
            <li><a href="https://github.com/johnnoel"><svg><use xlink:href="/img/icons.svg#github"></use></svg> My code on GitHub</a></li>
            <li><a href="https://www.last.fm/user/chaostangent"><svg><use xlink:href="/img/icons.svg#lastfm"></use></svg> My scrobbles on last.fm</a></li>
            <li><a href="https://www.flickr.com/photos/chaostangent/"><svg><use xlink:href="/img/icons.svg#flickr"></use></svg> My photos on Flickr</a></li>
            <li><a href="https://www.youtube.com/ChaosTangent"><svg><use xlink:href="/img/icons.svg#youtube"></use></svg> My videos on YouTube</a></li>
            <li><a href="https://chaostangent.tumblr.com/"><svg><use xlink:href="/img/icons.svg#youtube"></use></svg> My posts on Tumblr</a></li>
            <li><a href="https://www.twitch.tv/ceetea_"><svg><use xlink:href="/img/icons.svg#youtube"></use></svg> My videos on Twitch</a></li>
            <li><a href="{{ path('home:rss') }}"><svg><use xlink:href="/img/icons.svg#rss"></use></svg> RSS feed for chaostangent.com</a></li>
        </ul>
    </nav>

    <div class="sitefooter-copyright">
        <a href="{{ path('home') }}" class="logo logo-small">chaos<b>tangent</b></a> is John Noel &copy; {{ 'now'|date('Y') }}
    </div>
</footer>

<script src="{{ asset('main.js') }}"></script>
</body>
</html>
