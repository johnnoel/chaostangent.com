{% extends 'base.html.twig' %}
{% block title %}
    {{ year }}
    {% if page > 1 %}
        : Page {{ page }}
    {% endif %}
{% endblock title %}

{% block body %}
    {% include '_posts-list.html.twig' with {
        'posts': posts,
        'route': 'year:paginated',
        'page_1_route': 'year',
        'route_params': { 'year': year },
        'page': page,
        'pages': page_count,
        'title': 'Posts from ' ~ year,
    } %}
{% endblock body %}
