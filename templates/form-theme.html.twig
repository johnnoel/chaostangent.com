{% extends 'form_div_layout.html.twig' %}

{% block form_row %}
    {% set row_attr = row_attr|default({})|merge({ 'class': 'row' }) %}
    {{ parent(form) }}
{% endblock form_row %}

{% block form_label %}
    {% set label_attr = label_attr|default({})|merge({ 'class': 'label' }) %}
    {{ parent(form) }}
{% endblock form_label %}

{% block form_errors %}
    {% if errors|length > 0 %}
        <ul class="errors">
            {% for error in errors %}
                <li class="error">{{ error.message }}</li>
            {% endfor %}
        </ul>
    {% endif %}
{% endblock form_errors %}

{% block form_help -%}
    {%- if help is not empty -%}
        {%- set help_attr = help_attr|merge({class: (help_attr.class|default('') ~ ' help')|trim}) -%}
        <{{ element|default('div') }} id="{{ id }}_help"{% with { attr: help_attr } %}{{ block('attributes') }}{% endwith %}>
        {{- block('form_help_content') -}}
        </{{ element|default('div') }}>
    {%- endif -%}
{%- endblock form_help %}

{% block _comment_honeypot_row %}
    <div class="row honeypot">
        {{ form_label(form) }}
        {{ form_widget(form) }}
    </div>
{% endblock _comment_honeypot_row %}
