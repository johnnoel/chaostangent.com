{% extends 'base.html.twig' %}
{% block title %}
    {{ tag.tag }}
    {% if page > 1 %}
        : Page {{ page }}
    {% endif %}
{% endblock title %}

{% block body %}
    {% include '_posts-list.html.twig' with {
        'posts': posts,
        'route': 'tag:paginated',
        'page_1_route': 'tag',
        'route_params': { 'alias': tag.alias },
        'page': page,
        'pages': page_count,
        'title': 'Posts with the “' ~ tag.tag ~ '” tag',
    } %}
{% endblock body %}
