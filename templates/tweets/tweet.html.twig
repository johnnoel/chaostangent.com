{% extends 'base.html.twig' %}

{% block body %}
    <h1 class="_vh">Tweet {{ tweet.id }}</h1>

    <div class="single-tweet">
        <p>{{ tweet.fullText }}</p>
        <dl class="metadata">
            <dt>Original ID</dt>
            <dd>{{ tweet.id }}</dd>
            <dt>Created at</dt>
            <dd>
                <a href="{{ path('tweet', { 'id': tweet.id }) }}">
                    <time datetime="{{ tweet.createdAt|date('Y-m-d\\TH:i:sP') }}">{{ tweet.createdAt|date('Y-m-d H:i:s') }}</time>
                </a>
            </dd>
        </dl>

        <details class="original">
            <summary>Original JSON</summary>
            {% apply code('json') %}
                {{ tweet.original|json_encode(constant('JSON_PRETTY_PRINT') b-or constant('JSON_UNESCAPED_SLASHES'))|raw }}
            {% endapply %}
        </details>
    </div>

{% endblock body %}
