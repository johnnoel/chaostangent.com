<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>{{ post.fullTitle }}</title>
</head>
<body>
<h1>{{ post.fullTitle }}</h1>

{% if post.summary is not null %}
    <h2>Summary</h2>
    <pre><code>{{ post.summary }}</code></pre>
{% endif %}

<h2>Content</h2>
<pre><code>{{ post.content }}</code></pre>
</body>
</html>
