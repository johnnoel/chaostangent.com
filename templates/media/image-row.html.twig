<div class="image-row{% if classes is not empty %} {{ classes }}{% endif %}">
    <div class="images">
        {% for image in images %}
            <img src="{{ image.src }}" alt="{{ image.caption|default('') }}">
        {% endfor %}
    </div>
    {% if description is not empty %}
        <div class="description">{{ description|raw }}</div>
    {% endif %}
</div>
