{# route, route_params, page, pages #}
{% if route_params is not defined %}
    {% set route_params = {} %}
{% endif %}

{% if page_1_route is not defined %}
    {% set page_1_route = route %}
{% endif %}

{% macro li(page, current_page, route, page_1_route, route_params) %}
    <li>
        <a href="{{- _self.page_route(page, route, page_1_route, route_params)|trim -}}"{% if page == current_page %} class="active"{% endif %}>{{ page }}</a>
    </li>
{% endmacro %}

{% macro page_route(page, route, page_1_route, route_params) %}
    {% if page == 1 %}
        {{ path(page_1_route, route_params)|raw }}
    {% else %}
        {{ path(route, route_params|merge({ 'page': page }))|raw }}
    {% endif %}
{% endmacro %}

<nav class="posts-pagination" role="navigation">
    {% if page > 1 %}
        <a href="{{ _self.page_route(page - 1, route, page_1_route, route_params)|trim }}" class="prev">&larr; Previous <span>page</span></a>
    {% else %}
        <div class="prev">&larr; Previous <span>page</span></div>
    {% endif %}

    <ul class="pages">
        {% if pages < 7 %}
            {% for i in 1..pages %}
                {{ _self.li(i, page, route, page_1_route, route_params) }}
            {% endfor %}
        {% else %}
            {% for i in 1..3 %}
                {{ _self.li(i, page, route, page_1_route, route_params) }}
            {% endfor %}
            {% if page > 5 %}
                <li class="spacer">&hellip;</li>
            {% endif %}

            {% for i in (page - 1)..(page + 1) %}
                {% if i > 3 and i < (pages - 2) %}
                    {{ _self.li(i, page, route, page_1_route, route_params) }}
                {% endif %}
            {% endfor %}

            {% if page < (pages - 4) %}
                <li class="spacer">&hellip;</li>
            {% endif %}

            {% for i in (pages - 2)..pages %}
                {{ _self.li(i, page, route, page_1_route, route_params) }}
            {% endfor %}
        {% endif %}
    </ul>

    {% if page < pages %}
        <a href="{{ _self.page_route(page + 1, route, page_1_route, route_params)|trim }}" class="next">Next <span>page</span> &rarr;</a>
    {% else %}
        <div class="next">Next <span>page</span> &rarr;</div>
    {% endif %}
</nav>
