{
    "extends": "@tsconfig/recommended/tsconfig.json",
    "compilerOptions": {
        "module": "esnext",
        "outDir": "./public/assets/",
        "sourceMap": true,
        "strictNullChecks": true,
        "moduleResolution": "node",
        "allowSyntheticDefaultImports": true,
        "jsx": "react-jsx",
        "jsxImportSource": "preact"
    },
    "include": [
        "./assets/ts/"
    ]
}
